#!/usr/bin/env bash
# =============================================================================
# enroll-machine — make this machine able to read the secrets in this directory.
#
# The steps from secrets/README.md §5, in order:
#   1. give the machine a GPG key (primary ed25519 cert+sign, cv25519
#      encryption subkey, neither expiring)
#   2. export the public half to secrets/pubkeys/<hostname>.asc
#   3. add the fingerprint to .sops.yaml
#   4. re-encrypt the existing ciphertext to the new recipient list
#
# Step 4 needs a key that can ALREADY decrypt, which a new machine by
# definition does not have. So the run splits in two: on the new machine this
# script does 1–3 and stops; running it again on a machine that is already a
# recipient does 4. Everything is idempotent, so "run it on both" is the whole
# procedure — it skips whatever is already done.
# =============================================================================
set -euo pipefail

expire="never"
hostname_arg=""
name_arg=""
email_arg=""
do_commit=1

usage() {
  cat <<'EOF'
usage: enroll-machine [options]

  --hostname NAME   machine name to enroll        (default: hostname -s)
  --name NAME       real name on the GPG uid      (default: git config user.name)
  --email ADDR      email on the GPG uid          (default: git config user.email)
  --expire SPEC     primary key expiry            (default: never)
  --no-commit       leave the changes unstaged
  -h, --help        this

Run on the new machine, then on a machine that can already decrypt.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --hostname) hostname_arg="$2"; shift 2 ;;
    --name)     name_arg="$2";     shift 2 ;;
    --email)    email_arg="$2";    shift 2 ;;
    --expire)   expire="$2";       shift 2 ;;
    --no-commit) do_commit=0;      shift ;;
    -h | --help) usage; exit 0 ;;
    *) echo "enroll-machine: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

for tool in gpg sops git awk; do
  command -v "$tool" >/dev/null || { echo "enroll-machine: $tool not on PATH" >&2; exit 1; }
done

root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
sops_config="$root/.sops.yaml"
pubkeys="$root/secrets/pubkeys"
[ -f "$sops_config" ] || { echo "enroll-machine: no .sops.yaml at $root" >&2; exit 1; }

host="${hostname_arg:-$(hostname -s 2>/dev/null || uname -n)}"
host="${host%%.*}"

say() { printf '\n== %s\n' "$*"; }

# --- 1. the key -------------------------------------------------------------
# One key per machine, identified by the hostname in the uid comment:
#   Real Name (hostname) <email>
uid_of() { gpg --list-secret-keys --with-colons 2>/dev/null | awk -F: -v h="($host)" '
  $1 == "fpr" { fpr = $10 }
  $1 == "uid" && index($10, h) && fpr != "" { print fpr; exit }
'; }

fpr=$(uid_of || true)

if [ -n "$fpr" ]; then
  say "key for $host already present: $fpr"
else
  name="${name_arg:-$(git -C "$root" config user.name || true)}"
  email="${email_arg:-$(git -C "$root" config user.email || true)}"
  if [ -z "$name" ] || [ -z "$email" ]; then
    echo "enroll-machine: no git identity here; pass --name and --email" >&2
    exit 1
  fi

  say "generating a key for $host — you will be asked for a NEW passphrase"
  echo "   uid: $name ($host) <$email>"
  # Primary certifies and signs only. Neither half expires: a machine is
  # retired by dropping its fingerprint from .sops.yaml and re-encrypting.
  gpg --quick-generate-key "$name ($host) <$email>" ed25519 cert,sign "$expire"

  fpr=$(uid_of || true)
  [ -n "$fpr" ] || { echo "enroll-machine: key generated but not found by uid" >&2; exit 1; }

  gpg --quick-add-key "$fpr" cv25519 encr never
  say "created $fpr"
  echo "   back up its revocation certificate: ~/.gnupg/openpgp-revocs.d/$fpr.rev"
fi

# --- 2. the public half -----------------------------------------------------
mkdir -p "$pubkeys"
gpg --export --armor "$fpr" > "$pubkeys/$host.asc"
say "exported secrets/pubkeys/$host.asc"

# --- 3. the recipient list --------------------------------------------------
if grep -qi "$fpr" "$sops_config"; then
  echo "   .sops.yaml already lists $fpr"
else
  # Append to every `pgp: >-` block: sops splits that folded scalar on commas,
  # so one fingerprint per line stays readable and diffs cleanly.
  tmp=$(mktemp)
  awk -v fpr="$fpr" '
    function emit() {
      if (pend == "") return
      sub(/[[:space:]]*$/, "", pend)
      if (pend !~ /,$/) pend = pend ","
      print pend
      print indent fpr
      pend = ""
    }
    /^[[:space:]]*pgp:[[:space:]]*>-[[:space:]]*$/ { print; inblk = 1; next }
    {
      if (inblk && $0 ~ /^[[:space:]]+[0-9A-Fa-f]{40},?[[:space:]]*$/) {
        if (pend != "") print pend
        pend = $0
        indent = $0; sub(/[^[:space:]].*$/, "", indent)
        next
      }
      if (inblk) { emit(); inblk = 0 }
      print
    }
    END { emit() }
  ' "$sops_config" > "$tmp"

  if ! grep -qi "$fpr" "$tmp"; then
    rm -f "$tmp"
    echo "enroll-machine: could not find a 'pgp: >-' block in .sops.yaml." >&2
    echo "  Add $fpr to it by hand, then re-run." >&2
    exit 1
  fi
  mv "$tmp" "$sops_config"
  say "added $fpr to .sops.yaml"
fi

# --- 4. re-encrypt ----------------------------------------------------------
# Encrypting to a machine needs its public key in the local keyring. A rebuild
# imports secrets/pubkeys/*.asc, but this script must not wait for one.
for key in "$pubkeys"/*.asc; do
  [ -e "$key" ] || continue
  gpg --batch --quiet --import "$key" ||
    echo "   warning: cannot import $key — will not be able to encrypt to it" >&2
done

# Ciphertext, wherever it lives in secrets/ — anything sops has touched. Docs
# and public keys are excluded by name, so that prose about sops (this script
# included) is never mistaken for a secret.
secret_files=()
while IFS= read -r f; do
  secret_files+=("$f")
done < <(
  grep -rlF 'ENC[AES256_GCM' "$root/secrets" \
    --exclude='*.md' --exclude='*.asc' --exclude="$(basename "$0")" \
    2>/dev/null | sort
)

# sops records the PRIMARY fingerprint of every recipient inside the file, so a
# plain grep answers both "who can read this?" questions below.
mine=$(gpg --list-secret-keys --with-colons 2>/dev/null | awk -F: '$1 == "fpr" { print $10 }' || true)

# Every machine in the repo should be able to read every secret, so a file is
# stale if any published public key is missing from it — not just this one's.
# That is what makes the second run, on an old machine, pick up the new one.
repo_fprs=$(
  for key in "$pubkeys"/*.asc; do
    [ -e "$key" ] || continue
    gpg --show-keys --with-colons "$key" 2>/dev/null | awk -F: '$1 == "fpr" { print $10; exit }'
  done
)

stale=()
for f in "${secret_files[@]:-}"; do
  [ -n "$f" ] || continue
  for r in $repo_fprs; do
    if ! grep -qi "$r" "$f"; then stale+=("$f"); break; fi
  done
done

can_decrypt=0
for f in "${secret_files[@]:-}"; do
  [ -n "$f" ] || continue
  for m in $mine; do
    if grep -qi "$m" "$f"; then can_decrypt=1; break 2; fi
  done
done

failed=0
if [ ${#stale[@]} -eq 0 ]; then
  say "every secret is already encrypted to every machine in the repo"
elif [ "$can_decrypt" -eq 1 ]; then
  say "re-encrypting ${#stale[@]} file(s) — passphrase needed"
  for f in "${stale[@]}"; do
    echo "   ${f#"$root/"}"
    sops updatekeys --yes "$f" || failed=$((failed + 1))
  done
  [ "$failed" -eq 0 ] || echo "enroll-machine: $failed file(s) failed to re-encrypt" >&2
else
  say "cannot re-encrypt from here"
  cat <<EOF
   This machine holds no key that any existing secret was encrypted to, so it
   cannot decrypt them in order to re-encrypt. Commit and push what was done
   above, then run this same script on a machine that IS already a recipient:
   it will pick up the new fingerprint and run the re-encryption.
EOF
fi

# --- commit -----------------------------------------------------------------
if [ "$do_commit" -eq 1 ]; then
  git -C "$root" add -- .sops.yaml secrets
  if git -C "$root" diff --cached --quiet; then
    say "nothing to commit"
  else
    git -C "$root" commit -m "secrets: enroll $host"
    say "committed — push it, and rebuild on the other machines"
  fi
else
  say "left uncommitted (--no-commit)"
fi

[ "$failed" -eq 0 ] || exit 1
