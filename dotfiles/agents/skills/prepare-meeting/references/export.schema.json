{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "export.schema.json",
  "title": "MeetingExport",
  "description": "Outcome-only export from syncslids. No presentation data.",
  "type": "object",
  "required": ["meeting", "title", "exported_at", "items"],
  "additionalProperties": false,
  "properties": {
    "meeting": {
      "type": "string",
      "description": "Meeting label (from meeting.name)"
    },
    "title": {
      "type": "string",
      "description": "Meeting title (from meeting.title)"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of export"
    },
    "items": {
      "type": "array",
      "description": "Agenda items with captured outcome cards",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["topic", "description", "cards"],
      "additionalProperties": false,
      "properties": {
        "topic":       { "type": "string" },
        "description": { "type": "string", "default": "" },
        "cards": {
          "type": "array",
          "items": { "$ref": "#/$defs/card" }
        }
      }
    },
    "card": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
