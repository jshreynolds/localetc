#!/usr/bin/env python3

import subprocess
import sys


def main(argv: list[str]) -> int:
    if len(argv) < 3:
        print("usage: git_set_local_conf <name...> <email>", file=sys.stderr)
        return 2

    name = " ".join(argv[1:-1]).strip()
    email = argv[-1].strip()

    if not name:
        print("error: name must not be empty", file=sys.stderr)
        return 2
    if "@" not in email:
        print("error: email must contain @", file=sys.stderr)
        return 2

    subprocess.run(["git", "config", "--local", "user.name", name], check=True)
    subprocess.run(["git", "config", "--local", "user.email", email], check=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
