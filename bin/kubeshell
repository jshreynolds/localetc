#!/usr/bin/env bash

set -euo pipefail

scriptname=${0##*/}

if [[ $# -ne 2 ]]; then
    echo "Arguments missing!"
    echo "Usage: $scriptname podname namespace"
    echo "Example: $scriptname drone-ckyhsife drone"
    exit 1
fi

pod_name=$1
namespace=$2

kubectl exec --stdin --tty "$pod_name" --namespace="$namespace" -- /bin/sh
