#!/bin/bash
#
# skill-add — install a skill globally and register it in external-skills.list
#
# Usage: skill-add <source> [<skill-name>]
#   <source>      GitHub short path (org/repo), full GitHub URL,
#                 or any website with a well-known skills endpoint
#   <skill-name>  specific skill within the source (optional; omit to install all)
#
# Examples:
#   skill-add vercel-labs/agent-skills research-helper
#   skill-add microsoft/azure-skills microsoft-foundry
#   skill-add https://likec4.dev/ likec4-dsl
#   skill-add vercel-labs/agent-skills   # installs all skills from source
#

set -euo pipefail

SKILLS_LIST="${HOME}/etc/ai/external-skills.list"

if [[ $# -lt 1 || "$1" == "-h" || "$1" == "--help" ]]; then
    sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

if [[ $# -gt 2 ]]; then
    echo "Error: too many arguments"
    sed -n '5,8p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
fi

skill_source="$1"
skill_name="${2:-}"

mkdir -p "${HOME}/.agents/skills"

# Install via npx skills
if [[ -n "${skill_name}" ]]; then
    echo "Installing skill '${skill_name}' from ${skill_source}..."
    npx --yes skills add "${skill_source}" -g -y -s "${skill_name}"
    entry="${skill_source} ${skill_name}"
else
    echo "Installing all skills from ${skill_source}..."
    npx --yes skills add "${skill_source}" -g -y
    entry="${skill_source}"
fi

# Update external-skills.list — add entry if not already present
if grep -qxF "${entry}" "${SKILLS_LIST}" 2>/dev/null; then
    echo "Already in external-skills.list: ${entry}"
else
    echo "${entry}" >> "${SKILLS_LIST}"
    echo "Added to external-skills.list: ${entry}"
fi

# Mirror ~/.agents/skills into ~/.claude/skills (codex reads it natively)
"$(dirname "$0")/skill-sync"
