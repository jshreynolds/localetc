#!/usr/bin/env bash
#
# skill-sync — mirror ~/.agents/skills into ~/.claude/skills as per-skill symlinks.
#
# ~/.agents/skills is the canonical skills directory (the cross-tool "agents
# standard"). Codex reads it natively; Claude Code only reads ~/.claude/skills,
# flat, one symlink per skill — a whole-dir symlink is unsupported (claude
# writes .system metadata through it, polluting the shared directory).
#
# Extra skill repos may be passed as arguments: each top-level directory in
# them is linked into ~/.agents/skills first (same live-link scheme as the
# repo skills wired up by nix/home-manager/skills.nix). A missing repo only warns —
# it must never fail the activation (the repo may not be cloned everywhere).
#
# Runs on every rebuild (home-manager activation hook in nix/home-manager/skills.nix)
# and after every skill-add. Idempotent; prunes links it created whose skill
# is gone; never touches real dirs or links it doesn't own.

set -euo pipefail

src="${HOME}/.agents/skills"
dst="${HOME}/.claude/skills"

# legacy scheme: ~/.claude/skills as a whole-dir symlink — with dst == src the
# mirror loop would clobber the very links it mirrors; replace with a real dir
if [ -L "${dst}" ]; then
    rm "${dst}"
fi

mkdir -p "${src}" "${dst}"

# link skills from extra repos into ~/.agents/skills
for repo in "$@"; do
    if [ ! -d "${repo}" ]; then
        echo "skill-sync: warning: skill repo not found, skipping: ${repo}" >&2
        continue
    fi
    for skill in "${repo}"/*/; do
        [ -e "${skill}" ] || continue # glob matched nothing
        name="$(basename "${skill}")"
        entry="${src}/${name}"
        if [ -e "${entry}" ] && [ "$(readlink "${entry}" 2>/dev/null)" != "${repo}/${name}" ]; then
            echo "skill-sync: warning: ${name} already exists in ${src}, not linking from ${repo}" >&2
            continue
        fi
        ln -sfn "${repo}/${name}" "${entry}"
    done
    # prune dangling symlinks that point into this repo (skill removed)
    for link in "${src}"/*; do
        [ -L "${link}" ] || continue
        case "$(readlink "${link}")" in
        "${repo}"/*) [ -e "${link}" ] || rm "${link}" ;;
        esac
    done
done

# link every skill (hidden entries like .system are not matched by the glob)
for skill in "${src}"/*/; do
    [ -e "${skill}" ] || continue # glob matched nothing
    name="$(basename "${skill}")"
    ln -sfn "${src}/${name}" "${dst}/${name}"
done

# prune dangling symlinks that point into ~/.agents/skills (skill removed)
for link in "${dst}"/*; do
    [ -L "${link}" ] || continue
    case "$(readlink "${link}")" in
    "${src}"/*) [ -e "${link}" ] || rm "${link}" ;;
    esac
done
